{
  "version": 2,
  "about": "The action allow-list. Every step any ant can plan is one of these, with the step marker filled in. Each action is harmless by itself: it prints, reads or looks something up, and changes nothing that matters. 'fidelity: partial' means the real technique would change the system and this action only runs the same tool in a read-only way. 'tool' names the security tool whose logs, forwarded to Splunk, say what happened to the step; an email action goes to a test mailbox on the gatekeeper's scope list and nowhere else. 'techniques' gives each ATT&CK id its name and its tactic (the attack type the demo page colours and filters by).",
  "actions": {
    "echo_marker": {
      "description": "Run a shell that only echoes the step marker.",
      "command": "cmd.exe /c echo oaev-step-{marker}",
      "techniques": ["T1059.003"], "category": "endpoint", "fidelity": "full",
      "expect": {"falcon": "detection", "splunk": "detection"}
    },
    "ps_echo_marker": {
      "description": "Run PowerShell that only writes the step marker to its output.",
      "command": "powershell.exe -NoProfile -Command Write-Output oaev-step-{marker}",
      "techniques": ["T1059.001"], "category": "endpoint", "fidelity": "full",
      "expect": {"falcon": "detection", "splunk": "detection"}
    },
    "system_info": {
      "description": "Read basic system information.",
      "command": "cmd.exe /c systeminfo & rem oaev-step-{marker}",
      "techniques": ["T1082"], "category": "endpoint", "fidelity": "full",
      "expect": {"splunk": "detection"}
    },
    "network_config": {
      "description": "Read the network configuration.",
      "command": "cmd.exe /c ipconfig /all & rem oaev-step-{marker}",
      "techniques": ["T1016"], "category": "endpoint", "fidelity": "full",
      "expect": {"splunk": "detection"}
    },
    "whoami": {
      "description": "Read the current user and its groups.",
      "command": "cmd.exe /c whoami /all & rem oaev-step-{marker}",
      "techniques": ["T1033"], "category": "endpoint", "fidelity": "full",
      "expect": {"splunk": "detection"}
    },
    "process_list": {
      "description": "List running processes.",
      "command": "cmd.exe /c tasklist & rem oaev-step-{marker}",
      "techniques": ["T1057"], "category": "endpoint", "fidelity": "full",
      "expect": {"splunk": "detection"}
    },
    "local_groups": {
      "description": "List local groups.",
      "command": "cmd.exe /c net localgroup & rem oaev-step-{marker}",
      "techniques": ["T1069.001"], "category": "endpoint", "fidelity": "full",
      "expect": {"splunk": "detection"}
    },
    "local_accounts": {
      "description": "List local accounts.",
      "command": "cmd.exe /c net user & rem oaev-step-{marker}",
      "techniques": ["T1087.001"], "category": "endpoint", "fidelity": "full",
      "expect": {"splunk": "detection"}
    },
    "neighbours": {
      "description": "Read the table of recently seen neighbours on the network.",
      "command": "cmd.exe /c arp -a & rem oaev-step-{marker}",
      "techniques": ["T1018"], "category": "endpoint", "fidelity": "full",
      "expect": {"splunk": "detection"}
    },
    "portproxy_show": {
      "description": "Run the port-proxy tool in show mode. A real intrusion would add a proxy rule; this only lists them.",
      "command": "cmd.exe /c netsh interface portproxy show all & rem oaev-step-{marker}",
      "techniques": ["T1090.001"], "category": "network", "fidelity": "partial",
      "expect": {"falcon": "detection", "splunk": "detection"}
    },
    "drop_marker_file": {
      "description": "Create an empty file whose name carries the step marker, then delete it.",
      "command": "cmd.exe /c type nul > %TEMP%\\oaev-step-{marker}.txt & del %TEMP%\\oaev-step-{marker}.txt",
      "techniques": ["T1105"], "category": "endpoint", "fidelity": "partial",
      "expect": {"falcon": "prevention", "splunk": "detection"}
    },
    "dns_lookup_marker": {
      "description": "Look up a hostname under a reserved, non-resolving domain that carries the step marker.",
      "command": "nslookup oaev-step-{marker}.sim.invalid",
      "techniques": ["T1071.004"], "category": "network", "fidelity": "full",
      "expect": {"splunk": "detection"}
    },
    "tcp_probe": {
      "description": "Open and close one TCP connection from the source to the target address. No payload.",
      "command": "tcp-connect {target_ip}:445",
      "agentless": true,
      "techniques": ["T1021.002"], "category": "network", "fidelity": "partial",
      "expect": {"splunk": "detection"}
    },
    "email_marker": {
      "description": "Send one harmless, marked email to a dedicated test mailbox. Its only link points at a reserved address that cannot resolve.",
      "command": "send-test-mail --to {mailbox} --subject \"OAEV test oaev-step-{marker}\" --link http://oaev-step-{marker}.sim.invalid/",
      "techniques": ["T1566.002"], "category": "email", "fidelity": "partial", "tool": "Proofpoint",
      "expect": {"splunk": "prevention"}
    },
    "web_request_marker": {
      "description": "Request a marked web address on an in-scope test server, through the firewall.",
      "command": "curl.exe -s -m 5 http://{target_ip}/oaev-step-{marker}",
      "techniques": ["T1071.001"], "category": "network", "fidelity": "partial", "tool": "Check Point",
      "expect": {"splunk": "prevention"}
    }
  },
  "techniques": {
    "T1059.001": {"name": "PowerShell", "tactic": "execution"},
    "T1059.003": {"name": "Windows Command Shell", "tactic": "execution"},
    "T1082": {"name": "System Information Discovery", "tactic": "discovery"},
    "T1016": {"name": "System Network Configuration Discovery", "tactic": "discovery"},
    "T1033": {"name": "System Owner/User Discovery", "tactic": "discovery"},
    "T1057": {"name": "Process Discovery", "tactic": "discovery"},
    "T1069.001": {"name": "Permission Groups Discovery: Local Groups", "tactic": "discovery"},
    "T1087.001": {"name": "Account Discovery: Local Account", "tactic": "discovery"},
    "T1018": {"name": "Remote System Discovery", "tactic": "discovery"},
    "T1021.002": {"name": "Remote Services: SMB/Windows Admin Shares", "tactic": "lateral-movement"},
    "T1566.002": {"name": "Phishing: Spearphishing Link", "tactic": "initial-access"},
    "T1071.001": {"name": "Application Layer Protocol: Web Protocols", "tactic": "command-and-control"},
    "T1090.001": {"name": "Proxy: Internal Proxy", "tactic": "command-and-control"},
    "T1105": {"name": "Ingress Tool Transfer", "tactic": "command-and-control"},
    "T1071.004": {"name": "Application Layer Protocol: DNS", "tactic": "command-and-control"},
    "T1190": {"name": "Exploit Public-Facing Application", "tactic": "initial-access"},
    "T1078": {"name": "Valid Accounts", "tactic": "initial-access"},
    "T1070": {"name": "Indicator Removal", "tactic": "defense-evasion"},
    "T1562": {"name": "Impair Defenses", "tactic": "defense-evasion"},
    "T1003": {"name": "OS Credential Dumping", "tactic": "credential-access"},
    "T1486": {"name": "Data Encrypted for Impact", "tactic": "impact"},
    "T1490": {"name": "Inhibit System Recovery", "tactic": "impact"}
  },
  "not_simulated": {
    "T1003": "Credential dumping cannot be done harmlessly.",
    "T1070": "Removing logs or other traces would damage the evidence the test relies on.",
    "T1562": "Switching off a defence is not a harmless action.",
    "T1486": "Encrypting data is destructive.",
    "T1490": "Removing recovery data is destructive.",
    "T1078": "Using real accounts needs real credentials, which the ants never handle.",
    "T1190": "Exploiting a public-facing application is out of scope for a benign test."
  },
  "tests": [
    {"id": "T-EXEC-001", "title": "Command shell runs a marked command", "technique": "T1059.003",
     "action": "echo_marker", "expect": {"falcon": "detection", "splunk": "detection"}},
    {"id": "T-FILE-002", "title": "Marked file dropped in the temp folder", "technique": "T1105",
     "action": "drop_marker_file", "expect": {"falcon": "prevention", "splunk": "detection"}},
    {"id": "T-DNS-003", "title": "Lookup of a marked hostname", "technique": "T1071.004",
     "action": "dns_lookup_marker", "expect": {"splunk": "detection"}},
    {"id": "T-NET-004", "title": "Connection to a file-sharing port", "technique": "T1021.002",
     "action": "tcp_probe", "expect": {"splunk": "detection"}},
    {"id": "T-MAIL-005", "title": "Marked test email with a link", "technique": "T1566.002",
     "action": "email_marker", "expect": {"splunk": "prevention"}},
    {"id": "T-WEB-006", "title": "Marked web request through the firewall", "technique": "T1071.001",
     "action": "web_request_marker", "expect": {"splunk": "prevention"}}
  ]
}
